rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function ownerItem(uid, movieId) {
      return /databases/$(database)/documents/sharedMemoryOwners/$(uid)/items/$(movieId);
    }
    function memoryItem(memoryId) {
      return /databases/$(database)/documents/sharedMemories/$(memoryId);
    }
    function validMovie(movieId) {
      return movieId in ['chihiro', 'howl', 'totoro'];
    }
    function correctTitle(movieId, title) {
      return (movieId == 'chihiro' && title == 'El boleto de los recuerdos')
        || (movieId == 'howl' && title == 'La carta que nunca enviaste')
        || (movieId == 'totoro' && title == 'El recuerdo de la infancia');
    }
    function validPublicMemory(data) {
      return data.keys().hasAll(['authorName', 'isAnonymous', 'movieId', 'memoryTitle', 'memoryText', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['authorName', 'isAnonymous', 'movieId', 'memoryTitle', 'memoryText', 'status', 'createdAt', 'updatedAt'])
        && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 40
        && data.isAnonymous is bool
        && (!data.isAnonymous || data.authorName == 'Anónimo')
        && validMovie(data.movieId)
        && correctTitle(data.movieId, data.memoryTitle)
        && data.memoryText is string && data.memoryText.size() > 0 && data.memoryText.size() <= 500
        && data.memoryText.trim().size() > 0
        && data.status in ['pending', 'published', 'hidden']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function ownsMemory(memoryId, movieId) {
      return signedIn() && exists(ownerItem(request.auth.uid, movieId))
        && get(ownerItem(request.auth.uid, movieId)).data.memoryId == memoryId;
    }

    match /sharedMemoryOwners/{userId}/items/{movieId} {
      allow get, list: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && validMovie(movieId)
        && request.resource.data.keys().hasAll(['memoryId', 'movieId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['memoryId', 'movieId', 'createdAt'])
        && request.resource.data.movieId == movieId
        && request.resource.data.memoryId is string
        && request.resource.data.memoryId.size() >= 12
        && request.resource.data.memoryId.size() <= 80
        && request.resource.data.createdAt == request.time
        && !exists(memoryItem(request.resource.data.memoryId))
        && existsAfter(memoryItem(request.resource.data.memoryId))
        && getAfter(memoryItem(request.resource.data.memoryId)).data.movieId == movieId;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId
        && exists(memoryItem(resource.data.memoryId))
        && !existsAfter(memoryItem(resource.data.memoryId));
    }

    match /sharedMemories/{memoryId} {
      allow list: if resource.data.status == 'published';
      allow get: if resource.data.status == 'published'
        || ownsMemory(memoryId, resource.data.movieId);
      allow create: if signedIn()
        && validPublicMemory(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.memoryText ==
          get(/databases/$(database)/documents/storyProgress/$(request.auth.uid))
            .data.chapters[request.resource.data.movieId].answer
        && !exists(ownerItem(request.auth.uid, request.resource.data.movieId))
        && existsAfter(ownerItem(request.auth.uid, request.resource.data.movieId))
        && getAfter(ownerItem(request.auth.uid, request.resource.data.movieId)).data.memoryId == memoryId;
      allow update: if ownsMemory(memoryId, resource.data.movieId)
        && validPublicMemory(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['authorName', 'isAnonymous', 'memoryText', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if ownsMemory(memoryId, resource.data.movieId)
        && !existsAfter(ownerItem(request.auth.uid, resource.data.movieId));
    }

    match /sharedMemoryReports/{reporterId}/items/{memoryId} {
      allow get: if signedIn() && reporterId == request.auth.uid;
      allow list, update, delete: if false;
      allow create: if signedIn() && reporterId == request.auth.uid
        && request.resource.data.keys().hasAll(['memoryId', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['memoryId', 'reason', 'createdAt'])
        && request.resource.data.memoryId == memoryId
        && request.resource.data.reason == 'contenido-inapropiado'
        && request.resource.data.createdAt == request.time
        && exists(memoryItem(memoryId))
        && get(memoryItem(memoryId)).data.status == 'published';
    }

    match /progress/{userId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid;
    }

    match /storyProgress/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
